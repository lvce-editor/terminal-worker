{
  "name": "@lvce-editor/terminal-worker-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "author": "Lvce Editor",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "build:static": "node packages/build/src/build-static.js",
    "build:watch": "nodemon",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @lvce-editor/terminal-worker",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 150
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^17.6.0",
    "eslint": "^10.8.0",
    "knip": "^6.29.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  }
}
