{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext", "WebWorker"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
